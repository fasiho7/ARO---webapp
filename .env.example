# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file that contains secrets.

# --- Public (safe for the browser). Do not put secrets here. ---
# Express API origin used by the coding editor. Not a secret.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Required for authentication (Supabase Auth).
# Restart `next dev` after filling these in.
# Then run supabase/migrations/20260815_profiles_and_progress.sql,
# supabase/migrations/20260816_profile_update_grants.sql,
# supabase/migrations/20260816_profile_plan.sql,
# supabase/migrations/20260816_billing_payments.sql, and
# supabase/migrations/20260816_billing_payments_verify.sql in the SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only. Never prefix these with NEXT_PUBLIC_. ---
# Required from Phase 2. Bypasses Row Level Security — server use only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Future providers. Leave empty until a real vendor is chosen. ---
# Do not fake these integrations.
# AI keys belong in backend/.env only. Never add AI_API_KEY here.
# EXECUTION_PROVIDER=
# EXECUTION_API_KEY=
# Judge0 keys belong in backend/.env only. Never add JUDGE0_* here.
# Live merchant credentials belong in backend/.env only. Never add them here.
# BILLING_PROVIDER=
# BILLING_SECRET_KEY=

# Development-only entitlement test UI. The backend independently requires
# NODE_ENV=development, ENABLE_DEV_PRO_TESTING=true, and the signed-in user's
# Supabase id in DEV_PRO_TESTING_USER_IDS. Never enable this in production.
NEXT_PUBLIC_ENABLE_DEV_PRO_TESTING=false
