PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SUPABASE_URL=https://yvtdqwewgfzwwnticzhu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_7nlU1ogEmyvMWbbTSSN-HA_5ZOPFgVv

# Server-only. Required to record payments and set profiles.plan = pro
# after verified checkout. Never send this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Aro Pro price. Amount is set on the server, not by the browser.
PRO_PRICE_AMOUNT=499
PRO_PRICE_CURRENCY=PKR

# sandbox | production. Default sandbox unless PAYMENT_ENV=production.
PAYMENT_ENV=sandbox
# Public API origin used in provider return URLs. Required when the API is not localhost.
PUBLIC_API_URL=http://localhost:5000

# Development mock checkout. On in sandbox unless set to false.
# Never treat this as a real payment.
BILLING_MOCK_ENABLED=true

# Manual bank-transfer confirmation. Server-only. Never put this in the frontend.
BILLING_ADMIN_SECRET=

# Easypaisa hosted checkout (official Index.jsf / Confirm.jsf / inquire-transaction).
# Leave empty until the merchant kit credentials are issued. Do not invent values.
# Sandbox URLs are used when PAYMENT_ENV=sandbox.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
# Optional. Example: MA_PAYMENT_METHOD or CC_PAYMENT_METHOD
# EASYPAISA_PAYMENT_METHOD=
# Optional URL overrides from the merchant kit:
# EASYPAISA_INDEX_URL=
# EASYPAISA_CONFIRM_URL=
# EASYPAISA_INQUIRE_URL=

# JazzCash hosted checkout (official merchantform POST + HMAC-SHA256).
# Leave empty until sandbox merchant credentials are issued. Do not invent values.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Required in production. Sandbox default is the official JazzCash merchantform URL.
# JAZZCASH_CHECKOUT_URL=
# Optional status inquiry URL from the merchant kit:
# JAZZCASH_INQUIRY_URL=
# JAZZCASH_SUB_MERCHANT_ID=
# JAZZCASH_TXN_TYPE=

# Card uses JazzCash hosted MPGS or Easypaisa CC_PAYMENT_METHOD. Never send PAN/CVV to Aro.
# CARD_GATEWAY=jazzcash
# CARD_TXN_TYPE=

# Bank / local transfer. User-submitted references stay pending until admin resolve.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# Judge0 (server-only). Never expose these to the frontend.
# Example self-hosted: http://localhost:2358
# Example RapidAPI: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Optional. Required for RapidAPI hosts.
JUDGE0_API_HOST=
# Optional language ID overrides if your Judge0 instance differs.
# JUDGE0_LANG_CPP=54
# JUDGE0_LANG_C=50
# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_JAVA=62

# Aro AI Tutor (server-only). Never send these to the frontend.
# OpenAI: AI_PROVIDER=openai and AI_API_KEY (or OPENAI_API_KEY)
# Groq:   AI_PROVIDER=groq and AI_API_KEY (or GROQ_API_KEY)
AI_PROVIDER=openai
AI_API_KEY=
# Optional overrides:
# AI_MODEL=gpt-4o-mini
# AI_API_URL=https://api.openai.com/v1/chat/completions
