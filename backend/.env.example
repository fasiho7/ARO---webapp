# Backend-only development entitlement testing. Use real Supabase test users;
# this never creates a fake identity and is ignored outside development.
NODE_ENV=development
ENABLE_DEV_PRO_TESTING=true
DEV_PRO_TESTING_USER_IDS=ef11d6ae-afb1-4e75-9430-419d087ec13b

# Server-only. Must match the value in the project root .env.local (Next.js admin proxy).
BILLING_ADMIN_SECRET=
